# Local partner portal access. Never commit real credentials.
PARTNER_EMAIL=partner@example.com
PARTNER_PASSWORD=replace-with-a-local-password
PARTNER_SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-side AI provider. Never expose OPENAI_API_KEY through NEXT_PUBLIC_* variables.
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-5.6
# Optional: use a separate vision-capable model for uploaded photos.
# AI_IMAGE_MODEL=gpt-5.6-luna
OPENAI_API_KEY=replace-with-a-server-side-api-key
# Optional for an OpenAI-compatible provider. Leave unset for the OpenAI API.
# OPENAI_BASE_URL=https://provider.example/v1
