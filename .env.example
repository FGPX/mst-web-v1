# Local partner portal access. Never commit real credentials.
PARTNER_EMAIL=partner@example.com
PARTNER_PASSWORD=replace-with-a-local-password
PARTNER_SESSION_SECRET=replace-with-at-least-32-random-characters
 
# Server-side AI provider. Never expose AI keys through NEXT_PUBLIC_* variables.
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-5-nano
# Optional low-latency text model dedicated to AI Stylist recommendations.
AI_STYLIST_MODEL=gpt-5.6-luna
# Optional: use a separate vision-capable model for uploaded photos.
AI_IMAGE_MODEL=gpt-5.6-luna
# AI_IMAGE_MODEL=gpt-5.6-luna
# High-fidelity room staging uses the Image API edit endpoint.
AI_ROOM_VISUALIZATION_MODEL=gpt-image-2
OPENAI_API_KEY=replace-with-a-server-side-api-key
 
# Optional Gemini provider instead of OpenAI.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-a-google-ai-studio-key
# GEMINI_IMAGE_MODEL=gemini-3.6-flash
# Optional for an OpenAI-compatible provider. Leave unset for the OpenAI API.
# OPENAI_BASE_URL=https://provider.example/v1

# Retailer handover email. This implementation uses Resend's server-side API,
# or SMTP when EMAIL_* variables are configured. Never commit real passwords.
RESEND_API_KEY=replace-with-a-server-side-resend-key
RETAILER_FROM_EMAIL=Musterring Projects <projects@your-verified-domain.example>
RETAILER_HANDOVER_TO=retailer@example.com

# SMTP alternative (for Gmail, use a revoked/rotatable App Password, never the
# normal Google account password). EMAIL_USER is also the fallback recipient
# in local demo mode when RETAILER_HANDOVER_TO is not set.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=sender@example.com
# EMAIL_PASSWORD=replace-with-a-new-app-password
